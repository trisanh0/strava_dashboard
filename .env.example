# Strava Configuration
STRAVA_CLUB_ID=1346373
# Copy _strava4_session cookie value from your browser (Inspect -> Application -> Cookies -> www.strava.com)
STRAVA_SESSION_COOKIE=your_strava4_session_cookie_here

# Discord Webhook URL for activity notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Google Apps Script Web App Deployment URL (ends in /exec)
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec

# Shared Secret Key for Apps Script Webhook security
WEBHOOK_SECRET_KEY=sleep-comp-secret-key

# Check interval in minutes (default 60 = hourly)
POLL_INTERVAL_MINUTES=60
